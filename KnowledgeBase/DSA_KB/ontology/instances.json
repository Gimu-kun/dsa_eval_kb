        {
            "id": "I_CHAPTER_SEARCHING_AND_SORTING",
            "instanceOf": "O_C_CHAPTER_SEARCHING_AND_SORTING",
            "attributes": [
                {
                    "name": "chapterNumber",
                    "value": 2
                },
                {
                    "name": "title",
                    "value": "searching and sorting"
                },
                {
                    "name": "description",
                    "value": "Giới thiệu về các thuật toán tìm kiếm và sắp xếp. Các thuật toán tìm kiếm cơ bản được giới thiệu bao gồm tìm kiếm tuyến tính và tìm kiếm nhị phân. Các thuật toán sắp xếp cơ bản được giới thiệu bao gồm sắp xếp nổi bọt, sắp xếp chọn và sắp xếp chèn. Ngoài ra, chương này còn giới thiệu về độ phức tạp của các thuật toán tìm kiếm và sắp xếp."
                }
            ]
        },
        {
            "id": "I_CHAPTER_LINKED_LIST",
            "instanceOf": "O_C_CHAPTER_LINKED_LIST",
            "attributes": [
                {
                    "name": "chapterNumber",
                    "value": 3
                },
                {
                    "name": "title",
                    "value": "link list"
                },
                {
                    "name": "description",
                    "value": "Giới thiệu về danh sách liên kết, một cấu trúc dữ liệu cho phép lưu trữ và thao tác với dữ liệu động. Sinh viên sẽ được tìm hiểu về khái niệm node, con trỏ và các loại danh sách liên kết khác nhau, bao gồm danh sách liên kết đơn, danh sách liên kết đôi và danh sách liên kết vòng. Chương này bao gồm các thao tác chèn, xóa và duyệt danh sách, cung cấp nền tảng vững chắc cho việc hiểu các cấu trúc dữ liệu phức tạp hơn."
                }
            ]
        },
