{
    "rules": [
        {
            "id": "rul-000001",
            "name": "rubricValidate",
            "description": "Tổng các tiêu chí rubric bắt buộc phải bằng 1.0",
            "expression": "acc + comp + log = 1.0",
            "condition": {
                "condition_type": "Comparison",
                "operator": "EQ",
                "operands": [
                    {
                        "condition_type": "Arithmetic",
                        "operator": "ADD",
                        "operands": [
                            {
                                "operand_type": "variable",
                                "id": "OP_ACC",
                                "value": "acc"
                            },
                            {
                                "operand_type": "variable",
                                "id": "OP_COMP",
                                "value": "comp"
                            },
                            {
                                "operand_type": "variable",
                                "id": "OP_LOG",
                                "value": "log"
                            }
                        ]
                    },
                    {
                        "operand_type": "float",
                        "value": 1.0
                    }
                ]
            },
            "conclusion": [
                {
                    "type": "attribute",
                    "target_instance": "ques",
                    "attribute_name": "isRubricValid",
                    "valueType": "bool",
                    "value": true
                }
            ]
        },
        {
            "id": "rul-000002",
            "name": "definitenessValidate",
            "description": "Tính xác định hợp lệ khi cả dữ liệu đầu vào và đầu ra được xác định",
            "expression": "isIdentify(input) && isIdentify(output)",
            "condition": {
                "condition_type": "Logical",
                "operator": "AND",
                "operands": [
                    {
                        "condition_type": "FuncCall",
                        "operator": "isIdentify",
                        "operands": [
                            {
                                "operand_type": "variable",
                                "id": "OP_INPUT",
                                "value": "input"
                            }
                        ]
                    },
                    {
                        "condition_type": "FuncCall",
                        "operator": "isIdentify",
                        "operands": [
                            {
                                "operand_type": "variable",
                                "id": "OP_OUTPUT",
                                "value": "output"
                            }
                        ]
                    }
                ]
            },
            "conclusion": [
                {
                    "type": "attribute",
                    "target_instance": "def",
                    "attribute_name": "isValid",
                    "valueType": "bool",
                    "value": true
                }
            ]
        },
        {
            "id": "rul-000003",
            "name": "algorithmValidate",
            "description": "Thoả mãn tất cả đặc trưng của thuật giải",
            "expression": "def.isValid && cor.isValid && fin.isValid && fea.isValid && eff.isValid",
            "condition": {
                "condition_type": "Logical",
                "operator": "AND",
                "operands": [
                    {
                        "condition_type": "Comparison",
                        "operator": "EQ",
                        "operands": [
                            {
                                "operand_type": "variable",
                                "id": "OP_DEFINITENESS",
                                "value": "def.isValid"
                            },
                            {
                                "operand_type": "bool",
                                "value": true
                            }
                        ]
                    },
                    {
                        "condition_type": "Comparison",
                        "operator": "EQ",
                        "operands": [
                            {
                                "operand_type": "variable",
                                "id": "OP_CORRECTNESS",
                                "value": "cor.isValid"
                            },
                            {
                                "operand_type": "bool",
                                "value": true
                            }
                        ]
                    },
                    {
                        "condition_type": "Comparison",
                        "operator": "EQ",
                        "operands": [
                            {
                                "operand_type": "variable",
                                "id": "OP_FINITENESS",
                                "value": "fin.isValid"
                            },
                            {
                                "operand_type": "bool",
                                "value": true
                            }
                        ]
                    },
                    {
                        "condition_type": "Comparison",
                        "operator": "EQ",
                        "operands": [
                            {
                                "operand_type": "variable",
                                "id": "OP_FEASIBILITY",
                                "value": "fea.isValid"
                            },
                            {
                                "operand_type": "bool",
                                "value": true
                            }
                        ]
                    },
                    {
                        "condition_type": "Comparison",
                        "operator": "EQ",
                        "operands": [
                            {
                                "operand_type": "variable",
                                "id": "OP_EFFICIENCY",
                                "value": "eff.isValid"
                            },
                            {
                                "operand_type": "bool",
                                "value": true
                            }
                        ]
                    }
                ]
            },
            "conclusion": [
                {
                    "type": "attribute",
                    "target_instance": "algo",
                    "attribute_name": "isValid",
                    "valueType": "bool",
                    "value": true
                }
            ]
        }
    ]
}